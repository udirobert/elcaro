# Copy to .env and fill in. Never commit real keys.
# OpenAI-compatible chat endpoint. For the Lexsi hackathon we use the
# Hugging Face Inference Providers router (serverless, pay-per-token).
EVAL_BASE_URL=https://router.huggingface.co/v1
EVAL_API_KEY=hf_...

# Comma-separated model ids to evaluate. Must be allowed dense open-weight
# Cohere models for the Lexsi AI Safety & Alignment Hackathon, e.g.:
# EVAL_MODELS=CohereLabs/aya-expanse-32b,CohereLabs/tiny-aya-global
EVAL_MODELS=

# Trials per task (3-5 recommended)
EVAL_TRIALS=3
