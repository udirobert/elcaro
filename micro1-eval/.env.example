# Copy to .env and fill in. Never commit real keys.
# OpenAI-compatible chat endpoint. Default is OpenRouter.
EVAL_BASE_URL=https://openrouter.ai/api/v1
EVAL_API_KEY=sk-or-...

# Comma-separated model ids to evaluate, e.g.:
# EVAL_MODELS=openai/gpt-5,anthropic/claude-sonnet-4.5,google/gemini-2.5-pro
EVAL_MODELS=

# Trials per task (3-5 recommended)
EVAL_TRIALS=3
