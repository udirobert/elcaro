# Elcaro Miner — Caddy reverse proxy config
# Copy to: /etc/caddy/Caddyfile (or include from main Caddyfile)
# Caddy handles HTTPS automatically via Let's Encrypt.
#
# Replace api.elcaro.dev with your actual domain.

api.elcaro.dev {
	reverse_proxy localhost:8000

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Rate limiting (basic — 60 requests per minute per IP)
	# Requires caddy-ratelimit plugin. Remove this block if not installed.
	# rate_limit {remote.ip} 60r/m

	# Logging
	log {
		output file /var/log/caddy/elcaro-access.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}
