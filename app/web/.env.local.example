# URL of the Elcaro Python miner API
# In development: run `uvicorn miner.api:app --port 8000` from the repo root
# In production: https://api.elcaro.trustfall.xyz
ELCARO_MINER_URL=http://localhost:8000

# Telegraph node used by GET /api/telegraph/miners (Track 3 catalog).
# TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com

# Shared secret required as the `x-admin-token` header to read
# GET /api/analytics (event count + file age). Unset = endpoint disabled.
# ANALYTICS_ADMIN_TOKEN=your_admin_token

# WebMCP Evals CLI (browser mode only; smoke mode does not need a key).
# GOOGLE_AI=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# URL fetching on /scan ("Fetch page content" button). Without a key the
# button is hidden — pasting raw text still works unchanged. The server
# never fetches the user-supplied URL itself; the provider does the fetch
# (avoids SSRF against this deployment's own network). 1,000 free
# credits/month, 1 credit per 5 basic extracts. Sign up at https://tavily.com/
# TAVILY_API_KEY=tvly-your_api_key
