# URL of the Elcaro Python miner API
# In development: run `uvicorn miner.api:app --port 8000` from the repo root
# In production: https://api.elcaro.trustfall.xyz
ELCARO_MINER_URL=http://localhost:8000

# Telegraph node used by GET /api/telegraph/miners (Track 3 catalog).
# TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com

# WebMCP Evals CLI (browser mode only; smoke mode does not need a key).
# GOOGLE_AI=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
