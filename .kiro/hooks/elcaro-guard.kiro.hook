{
  "enabled": false,
  "name": "Elcaro injection guard (runCommand — disabled)",
  "description": "runCommand version — disabled because python.org Python 3.x on macOS ships without a CA bundle, causing SSL timeouts. Use the askAgent version instead.",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      "web"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "source .venv/bin/activate && python3 scripts/kiro-scan-hook.py",
    "timeout": 30
  }
}
