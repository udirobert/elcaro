# Elcaro environment configuration.
# Copy to .env (never commit .env) and fill in what you need. Everything here
# is optional — every feature degrades safely when unset.

# --- Deep analysis (optional LLM second pass) + R11 salience experiment ----
# Any OpenAI-compatible chat-completions endpoint. Without a key, deep_analysis
# is a safe no-op and the salience experiment's run step exits with a hint.
ELCARO_LLM_API_KEY=
# ELCARO_LLM_BASE_URL=https://api.openai.com/v1
# ELCARO_LLM_MODEL=gpt-4o-mini
# ELCARO_LLM_TIMEOUT=10

# --- Tier-2 mailbox oracle (AgentMail sponsor integration) -------------------
# With a key set, /redteam/run?execute=true delivers the first bypass trophies
# as REAL emails to a real victim-agent inbox — compliance is proven by the
# sent folder, not a regex over the model's reply.
# AGENTMAIL_API_KEY=
# AGENTMAIL_BASE_URL=https://api.agentmail.to/v0
# ELCARO_MAILBOX_MAX=5          # trophies per run given the mailbox treatment

# --- Sandboxed victim agent (Tenki sponsor integration) ----------------------
# With both keys set, the first ELCARO_TENKI_MAX trophies run the victim
# agent's decision+send inside a disposable Tenki VM; the sandbox is
# terminated when the run ends.
# TENKI_API_KEY=
# ELCARO_TENKI_MAX=3

# --- Verdict signing (Ed25519) --------------------------------------------
# When set, every /scan verdict carries a signature verifiable via /pubkey +
# /verify. Generate with: python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; import base64; print(base64.b64encode(Ed25519PrivateKey.generate().private_bytes_raw()).decode())"
# ELCARO_SIGNING_KEY=

# --- MCP server ------------------------------------------------------------
# Set for fully local, network-free scanning via the MCP tools.
# ELCARO_MCP_LOCAL=1

# --- Web app ----------------------------------------------------------------
# Miner URL the Next.js proxy targets (dev default below; production set in
# the Netlify environment).
# ELCARO_MINER_URL=http://localhost:8000

# Telegraph node the /api/telegraph/miners catalog proxy reads (Track 3).
# TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com

# --- SERV Reasoning (optional progressive enhancement) ---------------------
# Progressive-enhancement second-pass judge for borderline / deep-analysis
# cases. With SERV_ENABLED=1 AND SERV_API_KEY set the miner may consult SERV
# Reasoning (https://docs.openserv.ai/serv-reasoning) to upgrade TTP mapping,
# remediation guidance, and the safe_content substitution. Default OFF; the
# free fast path is unaffected (no network call, no key required).
#
# Fail-safe: if SERV returns 401/402/403 (credits expired / key revoked) the
# miner arms a short cooldown and falls back to the rule-based verdict.
# Rules always keep veto power — SERV can only refine within the rule-floor
# window. Sign up at https://console.openserv.ai/ ($5 starter credit).
# SERV_ENABLED=1
# SERV_API_KEY=
# SERV_BASE_URL=https://inference-api.openserv.ai/v1
# SERV_MODEL=gpt-5.4-mini
# SERV_TIMEOUT=8
